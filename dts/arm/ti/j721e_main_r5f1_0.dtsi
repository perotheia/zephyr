#include <ti/j721e_main_r5.dtsi>

/ {
	chosen {
		zephyr,system-timer = &timer14;
	};
};

&mbox2 {
	usr-id = <1>;
	/*
	 * Mailbox cluster 2 user 1 enters NAVSS0_INTR_ROUTER_0 (TI-SCI device 213)
	 * at input 429; output 283 of host MAIN_1_R5_0's range is wired to this
	 * core's VIM line 251 (outputs 256..287 = VIM 224..255).
	 */
	interrupts = <0 251 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
	ti,sci-ir-route = <213 429 283>;
	status = "okay";
};

&timer14 {
	status = "okay";
};

/*
 * MAIN UART3..9 reach R5FSS1 only through R5FSS1_INTROUTER0 (TI-SCI device
 * 135; its outputs 0..31 are this core's VIM lines 256..287, host MAIN_1_R5_0
 * owns outputs 0..127). UART4 and UART6 (the BeagleBone AI-64 header UARTs)
 * are routed here: UART4 in 189 -> out 0 (VIM 256), UART6 in 191 -> out 1
 * (VIM 257).
 */
&uart4 {
	interrupts = <0 256 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
	interrupt-parent = <&vim>;
	ti,sci-ir-route = <135 189 0>;
};

&uart6 {
	interrupts = <0 257 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
	interrupt-parent = <&vim>;
	ti,sci-ir-route = <135 191 1>;
};
